---
type Props = {}

const {} = Astro.props

const { default: connectionReceive } = await import(`./connection-receive.svg?raw`);
const { default: reportData } = await import(`./report-data.svg?raw`);
---

<cds-header aria-label='MTB Dashboard'>
	<cds-header-menu-button button-label-active='Close menu' button-label-inactive='Open menu'></cds-header-menu-button>
	<cds-header-name href='/' prefix='MTB'>[Dashboard]</cds-header-name>
</cds-header>

<cds-side-nav usage-mode='regular' aria-label='Side navigation'>
	<cds-side-nav-items>
		<cds-side-nav-link href='/'>
            <Fragment set:html={reportData} />
            Resumen
        </cds-side-nav-link>
		<cds-side-nav-link href='/registros'>
            <Fragment set:html={connectionReceive} />
            Registros
        </cds-side-nav-link>
	</cds-side-nav-items>
</cds-side-nav>

<main class='cds-content ui-shell-content'>
	<div class='cds-grid'>
		<div class='cds-row'>
			<div class='cds--offset-lg-3 cds--col-lg-13'>
				<slot />
			</div>
		</div>
	</div>
</main>

<style></style>

<script>
	import "@carbon/web-components/es/components/ui-shell/index.js"
	import "./container.scss"
</script>
