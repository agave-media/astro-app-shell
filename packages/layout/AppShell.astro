---
type Props = {};

const {} = Astro.props;
---

<cds-header aria-label="MALVA Dashboard">
	<cds-header-menu-button button-label-active="Close menu" button-label-inactive="Open menu"></cds-header-menu-button>
	<cds-header-name href="/" prefix="MALVA">[Dashboard]</cds-header-name>
</cds-header>

<cds-side-nav usage-mode="regular" aria-label="Side navigation">
	<cds-side-nav-items>
		<cds-side-nav-link large href="/">
			<connection-icon slot="title-icon"></connection-icon>
			Resumen
		</cds-side-nav-link>
		<cds-side-nav-link large href="/registros">
			<report-icon slot="title-icon"></report-icon>
			Registros
		</cds-side-nav-link>
	</cds-side-nav-items>
</cds-side-nav>

<main class="cds--content ui-shell-content">
	<div class="cds--grid">
		<div class="cds--row">
			<div class="cds--col-lg-13 cds--offset-lg-3">
				<slot />
			</div>
		</div>
	</div>
</main>

<style></style>

<script>
	import "@carbon/web-components/es/components/ui-shell/index.js";
	import "./container-v2.scss";
	import "./shell.scss";
    import "./icons/connection-icon"
    import "./icons/report-icon"
</script>
