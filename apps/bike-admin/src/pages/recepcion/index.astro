---
import Layout from "../../layouts/Layout.astro"
type Props = {}

const {} = Astro.props
---

<Layout title='Recepcion'>
	<div class='content-container'>
		<section class='content'>
			<cds-breadcrumb>
				<cds-breadcrumb-item>
					<cds-breadcrumb-link href='/'>Inicio</cds-breadcrumb-link>
				</cds-breadcrumb-item>
				<cds-breadcrumb-item>
					<cds-breadcrumb-link href='/recepcion' aria-current='page'>Recepcion</cds-breadcrumb-link>
				</cds-breadcrumb-item>
			</cds-breadcrumb>

			<h3>Recepcion de documentos</h3>
		</section>

		<cds-clickable-tile href="/recepcion/factura">Registro de factura</cds-clickable-tile>
	</div>
</Layout>

<style></style>
<script>
	import "@carbon/web-components/es/components/breadcrumb/index.js"
	import "@carbon/web-components/es/components/tile/clickable-tile.js"
</script>
