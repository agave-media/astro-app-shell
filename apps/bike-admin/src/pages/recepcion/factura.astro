---
import Layout from "../../layouts/Layout.astro"

type Props = {}

const {} = Astro.props
import qrCode from "./qr-code.svg";
---

<Layout title='Recepcion'>
	<div class='content-container'>
		<section class='content'>
			<cds-breadcrumb>
				<cds-breadcrumb-item>
					<cds-breadcrumb-link href='/'>Inicio</cds-breadcrumb-link>
				</cds-breadcrumb-item>
				<cds-breadcrumb-item>
					<cds-breadcrumb-link href='/recepcion'>Recepcion</cds-breadcrumb-link>
				</cds-breadcrumb-item>
				<cds-breadcrumb-item>
					<cds-breadcrumb-link href='/recepcion/factura' aria-current='page'>Registro</cds-breadcrumb-link>
				</cds-breadcrumb-item>
			</cds-breadcrumb>

			<h4 class="page-header">Registro de factura</h4>
		</section>

		<progress-indicator>
			<section class='content' slot='ubpp'>
				<form>
					<cds-form-item>
						<cds-date-picker name='fecha'>
							<cds-date-picker-input kind='single' label-text='Fecha'></cds-date-picker-input>
						</cds-date-picker>
					</cds-form-item>

					<cds-form-item>
						<cds-input id='input-ubpp' type='text' name='ubpp' label-text='UBPP'></cds-input>
					</cds-form-item>

					<cds-form-item>
						<cds-input
							id='input-jefe-administrativo'
							type='text'
							name='jefe-administrativo'
							label-text='Jefe administrativo'></cds-input>
					</cds-form-item>

					<cds-form-item>
						<cds-input
							id='input-delegado-inventarios'
							type='text'
							name='delegado-inventarios'
							label-text='Delegado de inventarios'></cds-input>
					</cds-form-item>

					<div class='btn-container'>
						<cds-btn>Siguiente</cds-btn>
					</div>
				</form>
			</section>

			<section class='content' slot='tipo'>
				<form>
					<cds-form-item reset-carbon>
						<fieldset>
							<legend>Tipo de afectacion</legend>
							<cds-radio-tile name='tipo_afectacion'>Recursos propios</cds-radio-tile>
							<cds-radio-tile name='tipo_afectacion'>Donacion</cds-radio-tile>
							<cds-radio-tile name='tipo_afectacion'>Subsidio</cds-radio-tile>
						</fieldset>
					</cds-form-item>

					<cds-form-item reset-carbon>
						<fieldset>
							<legend>Presupuesto</legend>
							<cds-radio-tile name='presupuesto'>2021</cds-radio-tile>
							<cds-radio-tile name='presupuesto'>2022</cds-radio-tile>
							<cds-radio-tile name='presupuesto'>2023</cds-radio-tile>
						</fieldset>
					</cds-form-item>

					<cds-form-item reset-carbon>
						<fieldset>
							<legend>Tipo de registro</legend>
							<cds-radio-tile name='tipo_registro'>Manteniento</cds-radio-tile>
							<cds-radio-tile name='tipo_registro'>Activo fijo</cds-radio-tile>
							<cds-radio-tile name='tipo_registro'>Control economico</cds-radio-tile>
							<cds-radio-tile name='tipo_registro'>Consumo</cds-radio-tile>
						</fieldset>
					</cds-form-item>

					<div class='btn-container'>
						<cds-btn kind='secondary'>Atras</cds-btn>
						<cds-btn>Siguiente</cds-btn>
					</div>
				</form>
			</section>

			<section class='content' slot='facturas'>
				<div class='factura-header-container'>
					<h3 class='form-section-header'>Relacion de facturas</h3>

					<cds-form-item reset-carbon>
						<cds-selectable-tile name='factura-digital'>Factura digital</cds-selectable-tile>
					</cds-form-item>
				</div>
				<form>
                    <div class="factura-scanner-container">
                        <div class="qr-icon-container">
                            <Fragment set:html={qrCode} />
                        </div>
                    </div>
					<!-- <div class='factura-uploader-container'>
						<cds-form-item>
							<cds-file-uploader helper-text='Subir archivo PDF del comprobante fiscal' label-text='PDF'>
								<cds-file-drop-container accept='application/pdf'>
									Arrastra y suelta archivo aquí o haz clic para cargar
								</cds-file-drop-container>
							</cds-file-uploader>
						</cds-form-item>

						<cds-form-item>
							<cds-file-uploader helper-text='Subir archivo XML del comprobante fiscal' label-text='XML'>
								<cds-file-drop-container accept='application/xml'>
									Arrastra y suelta archivo aquí o haz clic para cargar
								</cds-file-drop-container>
							</cds-file-uploader>
						</cds-form-item>
					</div> -->

					<cds-form-item>
						<cds-input id='input-proyecto' type='text' name='proyecto' label-text='Proyecto'></cds-input>
					</cds-form-item>

					<cds-form-item>
						<cds-input id='input-partida' type='text' name='partida' label-text='Partida'></cds-input>
					</cds-form-item>

                    <data-table></data-table>

					<div class='btn-container'>
						<cds-btn kind='secondary'>Atras</cds-btn>
						<cds-btn>Siguiente</cds-btn>
					</div>
				</form>
			</section>

			<section class='content' slot='relacion'>
				<form>
					<cds-form-item>
						<cds-file-uploader
							helper-text='Subir relacion completa de archivos'
							label-text='Relacion de archivos'
						>
							<cds-file-drop-container accept='application/pdf'>
								Arrastra y suelta archivos aquí o haz clic para cargar
							</cds-file-drop-container>
						</cds-file-uploader>
					</cds-form-item>

					<div class='btn-container'>
						<cds-btn kind='secondary'>Atras</cds-btn>
						<cds-btn>Siguiente</cds-btn>
					</div>
				</form>
			</section>
		</progress-indicator>
	</div>
</Layout>

<style>
	.btn-container {
		margin-top: 3em;
		display: flex;
		justify-content: flex-end;
		gap: 0.2em;
	}

	form {
		display: grid;
		gap: 2em;
	}

	fieldset {
		display: flex;
	}

	.factura-header-container {
		display: grid;
		grid-template-columns: 1fr auto;
	}

	.factura-uploader-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		justify-items: center;
	}

    .qr-icon-container {
        height: 80px;
        display: flex;
    }
</style>

<script>
	import "@carbon/web-components/es/components/breadcrumb/index.js"
	import "../../components/progress-indicator"
    import "../../components/data-table"

	import "@carbon/web-components/es/components/button/button.js"
	import "@carbon/web-components/es/components/form/form-item.js"
	import "@carbon/web-components/es/components/input/input.js"
	import "@carbon/web-components/es/components/notification/inline-notification.js"
	import "@carbon/web-components/es/components/date-picker/index.js"
	import "@carbon/web-components/es/components/tile/radio-tile.js"
	import "@carbon/web-components/es/components/tile/selectable-tile.js"
	import "@carbon/web-components/es/components/file-uploader/index.js"
</script>
